<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    />
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />
  </head>
  <body>
    <header class="container">
      <nav>
        <ul>
          <li>
            <a href="{{ '/' | url }}"><strong>{{ site.title }}</strong></a>
          </li>
        </ul>
        <ul>
          <li><a href="{{ '/' | url }}">All recipes</a></li>
        </ul>
      </nav>
    </header>

    <main class="container">{{ content | safe }}</main>

    <footer class="container">
      <small>
        {{ site.title }} — built with
        <a href="https://www.11ty.dev/">Eleventy</a>.
      </small>
    </footer>

    <script src="{{ '/assets/js/search.js' | url }}" defer></script>
  </body>
</html>
