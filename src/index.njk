---
layout: layouts/base.njk
title: ""
---
<div class="site-hero">
  <img class="site-hero__image" src="/assets/images/hero.jpg" alt="" width="1400" height="500" />
  <div class="site-hero__text">
    <h1 data-i18n="site.title">{{ site.title }}</h1>
    <p data-i18n="site.description">{{ site.description }}</p>
  </div>
</div>

<section class="recipe-controls" data-search-scope>
  <input
    type="search"
    id="recipe-search"
    placeholder="Szukaj przepisów…"
    data-i18n-placeholder="search.placeholder"
    aria-label="Search recipes"
  />

  <div class="tag-filters" role="group" aria-label="Filter by tag">
    <button type="button" class="tag-filter is-active" data-tag="" data-i18n="filter.all">Wszystkie</button>
    {% for tag in collections.tagList %}
      <button type="button" class="tag-filter" data-tag="{{ tag | lower }}">{{ tag }}</button>
    {% endfor %}
  </div>
</section>

<ul class="recipe-list" id="recipe-grid">
  {% for recipe in collections.recipes %}
    {% include "partials/recipe-card.njk" %}
  {% endfor %}
</ul>

<p class="no-results" id="no-results" hidden data-i18n="noResults">Żaden przepis nie pasuje do wyszukiwania.</p>
